<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PyExcel.Ribbon</RootNamespace>
    <AssemblyName>PyExcel.Ribbon</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcelDna.Integration only — we don't produce a .xll here, the Addin
      project does. We just need ExcelRibbon and IRibbonControl types.
    -->
    <PackageReference Include="ExcelDna.Integration" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PyExcel.Common\PyExcel.Common.csproj" />
    <ProjectReference Include="..\PyExcel.State\PyExcel.State.csproj" />
    <!--
      OnRunPython delegates to PyExcel.Excel.RangeRunner (net48-only) for
      the COM range read/marshal/run/write-back flow. This pulls the data
      plane (Apache.Arrow, Bridge, Kernel.Client) into the ribbon's
      dependency closure — fine for the production .xll, which is net48.
    -->
    <ProjectReference Include="..\PyExcel.Excel\PyExcel.Excel.csproj" />
    <!--
      OnAddAction / OnEditAction show the WinForms EditActionForm (Phase 8)
      and hand its RibbonAction result to StateService.AddAction. The forms
      assembly multi-targets net48 + netstandard2.0; the ribbon is net48,
      so it binds the net48 slice with the real WinForms dialog.
    -->
    <ProjectReference Include="..\PyExcel.Forms\PyExcel.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\RibbonUI.xml" />
    <!--
      The ribbon logo. LogicalName pins the manifest resource name to
      "customLogo.png" so PyExcelRibbon.LoadImage("customLogo") can fetch
      it by a stable name. The source PNG lives with the v1 ribbon assets.
    -->
    <EmbeddedResource Include="..\Ribbon\customLogo.png" LogicalName="customLogo.png" />
  </ItemGroup>

  <!--
    OnCopyLastError uses System.Windows.Forms.Clipboard.SetText. WinForms
    isn't in the default .NET Framework reference set for SDK-style net48
    projects, so add the assembly reference explicitly. (No package — it's
    part of the framework redist.)
  -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <!-- LoadImage decodes the embedded PNG into a System.Drawing.Bitmap. -->
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
