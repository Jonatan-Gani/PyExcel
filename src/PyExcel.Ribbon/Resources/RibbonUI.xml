<?xml version="1.0" encoding="utf-8"?>
<!--
  PyExcel ribbon definition. Ported verbatim from the original v1 VBA
  ribbon (since removed from the repository); every callback resolves to
  a method on PyExcel.Ribbon.PyExcelRibbon.

  Note that customLogo is now embedded via PyExcelRibbon.LoadImage(),
  not via the old Excel-DNA imageMso indirection.
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="RibbonOnLoad"
          loadImage="LoadImage">
    <ribbon>
        <tabs>
            <tab id="tabPython" label="Python">
                <group id="grpMain" label="Main">
                    <!--
                      "Enable" installs + enables in one action (Note 3): it
                      provisions the workbook (folders, venv, kernel, deps) and
                      marks it enabled. getEnabled=RibbonNotEnabled greys it once
                      the workbook is enabled so it can't be re-run by accident.
                    -->
                    <button id="btnEnablePyExcel" label="Enable" imageMso="ServerConnection" onAction="OnEnablePyExcel" getEnabled="RibbonNotEnabled"/>
                    <!--
                      Update is a placeholder for now: RibbonUpdateAvailable
                      always returns false (disabled) until the update mechanism
                      and a launch-time update check are built. See ROADMAP.md.
                    -->
                    <button id="btnUpdate" label="Update" imageMso="RefreshAll" onAction="OnUpdate" getEnabled="RibbonUpdateAvailable"/>
                    <button id="btnOpenExplorer" label="Open In Explorer" imageMso="FolderOpen" onAction="OnOpenExplorer" getEnabled="RibbonProjectEnabled"/>
                    <button id="btnReadMe" label="Read Me" imageMso="Help" onAction="OnReadMe" getEnabled="RibbonProjectEnabled"/>
                </group>
                <group id="grpErrors" label="Errors">
                    <!--
                      getEnabled is `RibbonHasError`, not `RibbonEnabled` —
                      errors are surfaceable independently of whether the
                      workbook has been enabled for PyExcel.
                    -->
                    <button id="btnShowLastError" label="Show Last Error" imageMso="ShowAllItems" onAction="OnShowLastError" getEnabled="RibbonHasError"/>
                    <button id="btnCopyLastError" label="Copy Last Error" imageMso="Copy" onAction="OnCopyLastError" getEnabled="RibbonHasError"/>
                </group>
                <group id="grpPython" label="Python">
                    <button id="btnRun" label="Run" size="large" image="customLogo" onAction="OnRunPython" getEnabled="RibbonEnabled"/>
                    <button id="btnEdit" label="Edit" size="large" imageMso="DatabaseSwitchboardManager" onAction="OnEditPython" getEnabled="RibbonEnabled"/>
                    <comboBox id="cmbScript" label="Script" sizeString="XXXXXXXXXXXXXXXXXX" getItemCount="GetScriptCount" getItemLabel="GetScriptLabel" getText="GetScriptText" onChange="OnScriptChange" getEnabled="RibbonEnabled"/>
                    <editBox id="txtPyInput" label="Input" sizeString="XXXXXXXXXXXXXXXXXXXX" getText="GetPyInput" onChange="OnPyInputChange" getEnabled="RibbonEnabled"/>
                    <editBox id="txtPyOutput" label="Output" sizeString="XXXXXXXXXXXXXXXXXXXX" getText="GetPyOutput" onChange="OnPyOutputChange" getEnabled="RibbonEnabled"/>
                    <comboBox id="cmbActions" getItemCount="GetActionCount" getItemLabel="GetActionLabel" getText="GetActionText" onChange="OnActionChange" sizeString="XXXXXXXXXXXXXXX" getEnabled="RibbonEnabled"/>
                    <buttonGroup id="bgExample">
                        <button id="btnAdd" label="Add" imageMso="DataFormAddRecord" onAction="OnAddAction" getEnabled="RibbonEnabled"/>
                        <button id="btnEditAction" label="Edit" imageMso="EditQuery" onAction="OnEditAction" getEnabled="RibbonEnabled"/>
                    </buttonGroup>
                    <button id="btnDelete" label="Delete Action" imageMso="CancelRequest" onAction="OnDeleteAction" getEnabled="RibbonEnabled"/>
                </group>
                <group id="grpImport" label="Import">
                    <button id="btnImport" label="Import" size="large" imageMso="Export" onAction="OnImport" getEnabled="RibbonWorkbookOpen"/>
                    <editBox id="txtImportInput" label="Source" getText="GetImportInput" sizeString="XXXXXXXXXXXXXXXXXXXX" onChange="OnImportInputChange" getEnabled="RibbonWorkbookOpen"/>
                    <editBox id="txtImportOutput" label="Destination" getText="GetImportOutput" sizeString="XXXXXXXXXXXXXXXXXXXX" onChange="OnImportOutputChange" getEnabled="RibbonWorkbookOpen"/>
                    <button id="btnEditImport" label="Edit" imageMso="EditQuery" size="large" onAction="OnEditImport" getEnabled="RibbonWorkbookOpen"/>
                </group>
                <group id="grpExport" label="Export">
                    <!--
                      Two buttons (Note: Wizard removed): Export opens the
                      configurable export dialog seeded with the saved defaults
                      and runs it; Edit configures and persists those defaults
                      (folder, file name, file type, and an optional unique-name
                      date/time stamp). The Source box mirrors the default source
                      range; "Saves to" is a read-only preview of the file name
                      the defaults produce (display-only — OnExportTargetChange
                      reverts hand edits).
                    -->
                    <button id="btnExport" label="Export" size="large" imageMso="Import" onAction="OnExport" getEnabled="RibbonWorkbookOpen"/>
                    <editBox id="txtExportInput" label="Source" getText="GetExportInput" sizeString="XXXXXXXXXXXXXXXXXXXX" onChange="OnExportInputChange" getEnabled="RibbonWorkbookOpen"/>
                    <editBox id="txtExportTarget" label="Saves to" getText="GetExportTarget" sizeString="XXXXXXXXXXXXXXXXXXXX" onChange="OnExportTargetChange" getEnabled="RibbonWorkbookOpen"/>
                    <button id="btnEditExport" label="Edit" imageMso="EditQuery" size="large" onAction="OnEditExport" getEnabled="RibbonWorkbookOpen"/>
                </group>
                <group id="grpPaste" label="Paste">
                    <button id="btnPaste" label="Paste" size="large" imageMso="Paste" onAction="OnPaste" getEnabled="RibbonWorkbookOpen"/>
                    <editBox id="txtPasteOutput" label="Destination" getText="GetPasteOutput" onChange="OnPasteOutputChange" sizeString="XXXXXXXXXXXXXXXXXXXX" getEnabled="RibbonWorkbookOpen"/>
                    <button id="btnEditPaste" label="Edit" imageMso="EditQuery" size="large" onAction="OnEditPaste" getEnabled="RibbonWorkbookOpen"/>
                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>
