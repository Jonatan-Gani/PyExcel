<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The C# half of the Excel data plane. Owns:
        * ArrowMarshal — C# ↔ Arrow IPC roundtrip mirroring embedded/pyexcel/kernel/arrow_io.py
        * (later) PythonResolver — locating the kernel's python executable
        * (later) KernelHost — lifecycle wrapper around KernelSupervisor + KernelClient
        * (later, net48-only) PyRunFunction — the =PY.RUN UDF
      Multi-targets net48 (production .xll) and netstandard2.0 (Linux CI build).
    -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>PyExcel.Excel</RootNamespace>
    <AssemblyName>PyExcel.Excel</AssemblyName>
    <Platforms>x64;AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="18.0.0" />
    <!--
      Excel-DNA is net48-only (production .xll) — there's no
      netstandard2.0 distribution and we wouldn't use it on Linux CI
      anyway. PyRunFunction.cs is #if NETFRAMEWORK so the
      netstandard2.0 build doesn't see the ExcelFunction attribute or
      ExcelError types at all.
    -->
    <PackageReference Include="ExcelDna.Integration" Version="1.8.0"
                      Condition="'$(TargetFramework)' == 'net48'" />
    <ProjectReference Include="..\PyExcel.Bridge\PyExcel.Bridge.csproj" />
    <ProjectReference Include="..\PyExcel.Kernel.Client\PyExcel.Kernel.Client.csproj" />
    <!--
      RangeRunner (net48-only) consumes WorkbookState + RibbonRangeParser
      from PyExcel.State. PyExcel.State multi-targets the same TFMs, so the
      reference resolves cleanly for both the net48 and netstandard2.0
      builds even though RangeRunner itself is #if NETFRAMEWORK.
    -->
    <ProjectReference Include="..\PyExcel.State\PyExcel.State.csproj" />
    <!--
      KernelHost resolves the per-project environment directory via
      PyExcel.Common.ProjectDirectory, the single rule shared with
      PyExcel.Setup so the runtime looks where Setup provisioned.
    -->
    <ProjectReference Include="..\PyExcel.Common\PyExcel.Common.csproj" />
  </ItemGroup>

  <!--
    RangeRunner drives Excel COM late-bound via `dynamic`. On .NET
    Framework the C# dynamic binder lives in Microsoft.CSharp.dll, which
    SDK-style net48 projects don't reference automatically (unlike .NET
    Core, where it's in the shared framework). netstandard2.0 doesn't
    need it — RangeRunner is #if NETFRAMEWORK and never compiles there.

    PasteService also uses System.Windows.Forms.MessageBox for the
    destructive-paste overwrite confirmation; that assembly likewise
    isn't in the SDK-style default reference set, so add it explicitly.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
