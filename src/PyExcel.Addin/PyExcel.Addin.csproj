<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48 only — this project produces the actual .xll, which requires the
      in-proc .NET Framework hosting model that Excel-DNA targets. The .NET 6+
      out-of-process loader is a different story and explicitly out of scope
      for v2.0 per the plan.
    -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PyExcel.Addin</RootNamespace>
    <AssemblyName>PyExcel.Addin</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Point the build at app.config explicitly (rather than relying on
      SDK auto-detection) so ExcelDna.AddIn copies our binding redirects
      into PyExcel-AddIn64.xll.config. Those redirects are what let
      Apache.Arrow's System.* dependencies bind at load on net48.
    -->
    <AppConfig>app.config</AppConfig>

    <!--
      Excel-DNA add-in descriptor — auto-generated, NOT a hand-written
      .dna file. The custom PyExcel-AddIn.dna that used to live next to
      this csproj was removed because the CreateExcelAddIn task ignores
      AddInInclude / AddInExports MSBuild properties when a user-supplied
      .dna exists (it copies the user file verbatim). That blocked us
      from feeding the OutDir glob into the pack list — see the
      PackedReferences target at the bottom of this file plus
      ExcelAddInExports below.

      Properties that map into the generated .dna:
        ExcelAddInName              -> <DnaLibrary Name="..." />
        ExcelAddInExports           -> additional <ExternalLibrary> entries
                                       (SCANNED for [ExcelRibbon] /
                                        [ExcelFunction])
        ExcelAddInInclude           -> additional <Reference> entries
                                       (PACKED but not scanned) — set by
                                       PackedReferences target from the
                                       OutDir glob
        ExcelAddInExplicitExports   -> per-ExternalLibrary attribute;
                                       false = scan every public static
                                       method as a candidate UDF
        ExcelAddInLoadFromBytes     -> per-ExternalLibrary attribute;
                                       true = load via Assembly.Load(byte[])
                                       from the packed resource, not from
                                       a loose DLL on disk
    -->
    <ExcelAddInName>PyExcel</ExcelAddInName>
    <ExcelAddInExports>PyExcel.Ribbon.dll;PyExcel.Excel.dll</ExcelAddInExports>
    <ExcelAddInExplicitExports>false</ExcelAddInExplicitExports>
    <ExcelAddInLoadFromBytes>true</ExcelAddInLoadFromBytes>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcelDna.AddIn pulls in ExcelDna.Integration and wires up the build
      target that produces the .xll. Version pinned to a 1.8.x release;
      bump deliberately, never via wildcard, so packaging stays reproducible.
    -->
    <PackageReference Include="ExcelDna.AddIn" Version="1.8.0" />
    <!--
      Typed Office PIA. AppEventSink needs typed Application events (you
      can't `+=` over a late-bound `dynamic`), so this is the one spot
      PyExcel references the Excel interop. ExcelDna.Interop ships the PIA
      DLLs (Excel/Office/VBE) under lib/net452 plus a build .targets that
      flips them to EmbedInteropTypes after ResolveReferences.

      The package also ships a build .targets that flips these PIAs to
      EmbedInteropTypes automatically, but to guarantee the types are present
      under `dotnet build` (Core MSBuild — what CI uses) we reference the DLLs
      EXPLICITLY with EmbedInteropTypes below (the canonical way to embed a
      NuGet-delivered PIA), using GeneratePathProperty to expose the restored
      package root as $(PkgExcelDna_Interop). CI diagnostics confirmed this
      resolves: the DLL exists at the HintPath and reaches the compiler with
      Embed=true.

      NOTE: the earlier CS0234 "type 'Workbook' does not exist in namespace
      'PyExcel.Excel'" errors were NOT a reference problem — they were a C#
      name-resolution bug (the `Excel` using-alias shadowed by our own
      PyExcel.Excel namespace because it sat above the file-scoped namespace).
      That is fixed in AppEventSink.cs / WorkbookStatePersister.cs by moving
      the alias inside the namespace, not by anything in this file.

      IMPORTANT: GeneratePathProperty must stand alone here. Do NOT add
      ExcludeAssets="all" (an earlier attempt did): that leaves
      $(PkgExcelDna_Interop) empty, so the HintPaths below resolve to nothing
      and the interop types genuinely go missing (a real "are you missing an
      assembly reference" CS0234). Embedding => the shipped .xll carries no
      runtime PIA dependency. Pinned, never wildcard.
    -->
    <PackageReference Include="ExcelDna.Interop" Version="15.0.1"
                      GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    Explicit, embedded references to the PIA assemblies the ExcelDna.Interop
    package restored (paths verified from the .nupkg: lib/net452, which is
    net48-compatible). We mirror the package's own embed set (Excel + Office
    + VBE) so any transitive type an embedded Excel member needs is present.
    Private=false: embedded types are baked into PyExcel.Addin.dll, so the
    DLLs must NOT be copied to output or packed into the .xll.
  -->
  <ItemGroup>
    <Reference Include="Microsoft.Office.Interop.Excel">
      <HintPath>$(PkgExcelDna_Interop)\lib\net452\Microsoft.Office.Interop.Excel.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Office">
      <HintPath>$(PkgExcelDna_Interop)\lib\net452\Office.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Vbe.Interop">
      <HintPath>$(PkgExcelDna_Interop)\lib\net452\Microsoft.Vbe.Interop.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PyExcel.Common\PyExcel.Common.csproj" />
    <ProjectReference Include="..\PyExcel.Ribbon\PyExcel.Ribbon.csproj" />
    <ProjectReference Include="..\PyExcel.State\PyExcel.State.csproj" />
    <!-- PyExcel.Setup ships the embedded kernel sources + the venv/pip
         pipeline; first-run wizard (Phase 8) plus any future bootstrap
         path drives it from this assembly. -->
    <ProjectReference Include="..\PyExcel.Setup\PyExcel.Setup.csproj" />
  </ItemGroup>

  <!--
    ExcelWorkbookContext reads Application.ActiveWorkbook late-bound via
    `dynamic`. The C# dynamic binder on .NET Framework lives in
    Microsoft.CSharp.dll, which SDK-style net48 projects don't reference
    by default — without it the compiler can't emit the call sites
    (error CS0656, CSharpArgumentInfo.Create).
  -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!--
    Pack every .dll that lands next to the .xll into the packed .xll's
    resources. This is what makes the shipped .xll truly standalone — a
    user dragging it into Excel gets one file with PyExcel.Common,
    .State, .Bridge, .Kernel.Client, .Setup, Apache.Arrow,
    Google.FlatBuffers, and the System.* polyfills (System.Memory,
    System.Buffers, System.Numerics.Vectors, System.Runtime.Compiler-
    Services.Unsafe, System.Threading.Tasks.Extensions) embedded.

    Why dynamic over hand-listing: net48 doesn't generate .deps.json,
    so Excel-DNA's ExcelDnaPackManagedDependencies auto-pack mode is
    .NET-6-only and doesn't apply. Hand-listing each dependency by
    name is brittle — bumping Apache.Arrow would silently rot the
    list until the .xll dies at load time with a missing-assembly
    error. The glob captures whatever the build actually produced.

    The exclude list keeps out the 3 assemblies that are already
    <ExternalLibrary> entries in the auto-generated .dna (so they're
    SCANNED, not just packed):
      * $(TargetFileName) — PyExcel.Addin.dll, the implicit primary
        ExternalLibrary entry CreateExcelAddIn always emits.
      * PyExcel.Ribbon.dll / PyExcel.Excel.dll — listed via
        ExcelAddInExports in the PropertyGroup above. Without these
        exclusions ExcelDnaPack would refuse to pack them twice.

    Pattern adapted from Excel-DNA discussion #595. Must run BEFORE
    ExcelDnaBuild — CreateExcelAddIn reads $(ExcelAddInInclude) at
    task-invocation time and bakes its value into the generated .dna
    via <Reference Path="X" Pack="true"/> entries. Setting the property
    after the task ran would silently no-op.
  -->
  <Target Name="PackedReferences"
          AfterTargets="AfterBuild"
          BeforeTargets="ExcelDnaBuild">
    <ItemGroup>
      <_ExcelDnaPackedRef Include="$(OutDir)*.dll"
                          Exclude="$(OutDir)$(TargetFileName);$(OutDir)PyExcel.Ribbon.dll;$(OutDir)PyExcel.Excel.dll" />
    </ItemGroup>
    <PropertyGroup>
      <!-- Project semicolon-separated list of bare filenames — CreateExcelAddIn
           writes them straight into <Reference Path="..."/> entries; the
           pack tool then resolves them relative to the .dna's directory
           (i.e. OutDir). Full paths would also work but bare names match
           the existing entries in the generated .dna and read cleaner. -->
      <ExcelAddInInclude>@(_ExcelDnaPackedRef->'%(Filename)%(Extension)', ';')</ExcelAddInInclude>
    </PropertyGroup>
    <Message Importance="high"
             Text="PackedReferences: bundling @(_ExcelDnaPackedRef->Count()) extra DLL(s) into the .xll: $(ExcelAddInInclude)" />
  </Target>

</Project>
