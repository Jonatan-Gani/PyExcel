<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48 only — this project produces the actual .xll, which requires the
      in-proc .NET Framework hosting model that Excel-DNA targets. The .NET 6+
      out-of-process loader is a different story and explicitly out of scope
      for v2.0 per the plan.
    -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PyExcel.Addin</RootNamespace>
    <AssemblyName>PyExcel.Addin</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Point the build at app.config explicitly (rather than relying on
      SDK auto-detection) so ExcelDna.AddIn copies our binding redirects
      into PyExcel-AddIn64.xll.config. Those redirects are what let
      Apache.Arrow's System.* dependencies bind at load on net48.
    -->
    <AppConfig>app.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcelDna.AddIn pulls in ExcelDna.Integration and wires up the build
      target that produces the .xll. Version pinned to a 1.8.x release;
      bump deliberately, never via wildcard, so packaging stays reproducible.
    -->
    <PackageReference Include="ExcelDna.AddIn" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PyExcel.Common\PyExcel.Common.csproj" />
    <ProjectReference Include="..\PyExcel.Ribbon\PyExcel.Ribbon.csproj" />
    <ProjectReference Include="..\PyExcel.State\PyExcel.State.csproj" />
  </ItemGroup>

  <!--
    ExcelWorkbookContext reads Application.ActiveWorkbook late-bound via
    `dynamic`. The C# dynamic binder on .NET Framework lives in
    Microsoft.CSharp.dll, which SDK-style net48 projects don't reference
    by default — without it the compiler can't emit the call sites
    (error CS0656, CSharpArgumentInfo.Create).
  -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
