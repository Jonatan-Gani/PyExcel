<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48 only — this project produces the actual .xll, which requires the
      in-proc .NET Framework hosting model that Excel-DNA targets. The .NET 6+
      out-of-process loader is a different story and explicitly out of scope
      for v2.0 per the plan.
    -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PyExcel.Addin</RootNamespace>
    <AssemblyName>PyExcel.Addin</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Point the build at app.config explicitly (rather than relying on
      SDK auto-detection) so ExcelDna.AddIn copies our binding redirects
      into PyExcel-AddIn64.xll.config. Those redirects are what let
      Apache.Arrow's System.* dependencies bind at load on net48.
    -->
    <AppConfig>app.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcelDna.AddIn pulls in ExcelDna.Integration and wires up the build
      target that produces the .xll. Version pinned to a 1.8.x release;
      bump deliberately, never via wildcard, so packaging stays reproducible.
    -->
    <PackageReference Include="ExcelDna.AddIn" Version="1.8.0" />
    <!--
      Typed Office PIA. AppEventSink needs typed Application events (you
      can't `+=` over a late-bound `dynamic`), so this is the one spot
      PyExcel references the Excel interop. ExcelDna.Interop ships the PIA
      DLLs (Excel/Office/VBE) under lib/net452 plus a build .targets that
      flips them to EmbedInteropTypes after ResolveReferences.

      That implicit mechanism did NOT surface the types on the Windows CI
      runner (CS0234 "type 'Workbook' does not exist in namespace
      'PyExcel.Excel'" — the `Excel` alias falling back to our own
      namespace — both with and without an <EmbedInteropTypes> child). So
      we restore the package only for its DLLs (GeneratePathProperty
      exposes its root as $(PkgExcelDna_Interop); ExcludeAssets=all stops
      its own asset/targets path) and reference the assemblies EXPLICITLY
      with EmbedInteropTypes below — the canonical, deterministic way to
      embed a NuGet-delivered PIA. Embedding => the shipped .xll carries no
      runtime PIA dependency. Pinned, never wildcard, so packaging stays
      reproducible.
    -->
    <PackageReference Include="ExcelDna.Interop" Version="15.0.1"
                      GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <!--
    Explicit, embedded references to the PIA assemblies the ExcelDna.Interop
    package restored (paths verified from the .nupkg: lib/net452, which is
    net48-compatible). We mirror the package's own embed set (Excel + Office
    + VBE) so any transitive type an embedded Excel member needs is present.
    Private=false: embedded types are baked into PyExcel.Addin.dll, so the
    DLLs must NOT be copied to output or packed into the .xll.
  -->
  <ItemGroup>
    <Reference Include="Microsoft.Office.Interop.Excel">
      <HintPath>$(PkgExcelDna_Interop)\lib\net452\Microsoft.Office.Interop.Excel.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Office">
      <HintPath>$(PkgExcelDna_Interop)\lib\net452\Office.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Vbe.Interop">
      <HintPath>$(PkgExcelDna_Interop)\lib\net452\Microsoft.Vbe.Interop.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PyExcel.Common\PyExcel.Common.csproj" />
    <ProjectReference Include="..\PyExcel.Ribbon\PyExcel.Ribbon.csproj" />
    <ProjectReference Include="..\PyExcel.State\PyExcel.State.csproj" />
  </ItemGroup>

  <!--
    ExcelWorkbookContext reads Application.ActiveWorkbook late-bound via
    `dynamic`. The C# dynamic binder on .NET Framework lives in
    Microsoft.CSharp.dll, which SDK-style net48 projects don't reference
    by default — without it the compiler can't emit the call sites
    (error CS0656, CSharpArgumentInfo.Create).
  -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
