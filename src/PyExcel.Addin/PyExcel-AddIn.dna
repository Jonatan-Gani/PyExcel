<?xml version="1.0" encoding="utf-8"?>
<!--
  Excel-DNA add-in descriptor. Read by Excel when it loads the .xll.

  RuntimeVersion="v4.0" matches our net48 target. The CLR Bridge will load
  this assembly and call AddIn.AutoOpen()/AutoClose() at the appropriate
  lifecycle points. See PyExcel.Addin.AddIn.cs for those entry points.

  CustomUI is wired via the ExcelRibbon-derived PyExcelRibbon class in
  PyExcel.Ribbon.dll. Excel-DNA only scans assemblies listed here as
  <ExternalLibrary> for [ExcelRibbon] classes (and [ExcelFunction]s) —
  a merely-referenced dependency is NOT packed either, contrary to an
  earlier (wrong) comment here. ExcelDnaPack only embeds assemblies that
  are explicitly listed in this file, via either <ExternalLibrary> (for
  assemblies that should also be scanned for Excel-DNA content) or
  <Reference> (for plain dependencies that should ride along but not be
  scanned). Without these, the packed .xll references types that aren't
  in the .xll's manifest and FileNotFoundException fires at load time —
  symptom: "Could not load file or assembly 'PyExcel.Common, …'" the
  first time Excel-DNA instantiates PyExcelRibbon.

  When adding a new project that the .xll needs at runtime, add a
  <Reference> entry below (use <ExternalLibrary> only if the new
  assembly itself defines [ExcelRibbon] or [ExcelFunction] members).
-->
<DnaLibrary Name="PyExcel" RuntimeVersion="v4.0">
  <!--
    Scanned assemblies — Excel-DNA reflects over each looking for
    [ExcelRibbon] / [ExcelFunction] / [ExcelCommand] entry points.
  -->
  <ExternalLibrary Path="PyExcel.Addin.dll"
                   ExplicitExports="false"
                   LoadFromBytes="true"
                   Pack="true" />
  <ExternalLibrary Path="PyExcel.Ribbon.dll"
                   ExplicitExports="false"
                   LoadFromBytes="true"
                   Pack="true" />
  <ExternalLibrary Path="PyExcel.Excel.dll"
                   ExplicitExports="false"
                   LoadFromBytes="true"
                   Pack="true" />

  <!--
    Plain dependencies — packed into the .xll so the binary is
    standalone, but not scanned (these projects don't carry any
    Excel-DNA-recognised attributes).
  -->
  <Reference Path="PyExcel.Common.dll" Pack="true" />
  <Reference Path="PyExcel.State.dll" Pack="true" />
  <Reference Path="PyExcel.Bridge.dll" Pack="true" />
  <Reference Path="PyExcel.Kernel.Client.dll" Pack="true" />
  <Reference Path="PyExcel.Setup.dll" Pack="true" />

  <!--
    Third-party data-plane: Apache.Arrow (the C# Arrow IPC) plus the
    System.* polyfills it transitively requires on net48. The version
    redirects in app.config (copied to PyExcel-AddIn64.xll.config) point
    at the exact AssemblyVersion that ships in the build output; these
    DLLs must be present in the .xll's packed resources for the
    redirects to find a target.
  -->
  <Reference Path="Apache.Arrow.dll" Pack="true" />
  <Reference Path="Google.FlatBuffers.dll" Pack="true" />
  <Reference Path="System.Runtime.CompilerServices.Unsafe.dll" Pack="true" />
  <Reference Path="System.Memory.dll" Pack="true" />
  <Reference Path="System.Buffers.dll" Pack="true" />
  <Reference Path="System.Numerics.Vectors.dll" Pack="true" />
  <Reference Path="System.Threading.Tasks.Extensions.dll" Pack="true" />
</DnaLibrary>
